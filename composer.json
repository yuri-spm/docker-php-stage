{
    "name": "bevith/docker-php",
    "description": "A PHP library for Docker integration",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuri do Monte",
            "email": "yspm.developer@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "google/apiclient": "^2.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Bevith\\DockerPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bevith\\DockerPhp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
